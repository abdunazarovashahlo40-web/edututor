# =====================================================================
# EduTutor — muhit o'zgaruvchilari. Nusxa oling:  cp .env.example backend/.env  (Windows: copy .env.example backend\.env)
# Haqiqiy qiymatlarni HECH QACHON GitHub'ga yuklamang.
# =====================================================================

NODE_ENV=development
PORT=4000
# Saytning ochiq manzili (Render'da: https://edututor.onrender.com)
APP_URL=http://localhost:5173
# Tasdiqlangan origin'lar (vergul bilan). Dev'da Vite 5173.
CORS_ORIGINS=http://localhost:5173

# ---------- Ma'lumotlar bazasi (Supabase PostgreSQL) ----------
# Supabase -> Project Settings -> Database -> Connection string
# Ilova uchun pooler (6543, Transaction mode):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edututor?schema=public
# Migratsiyalar uchun to'g'ridan-to'g'ri ulanish (5432, Session mode):
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/edututor?schema=public

# ---------- Xavfsizlik ----------
# Har biri kamida 32 belgili tasodifiy satr:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Kirish kodi (PIN) / barmoq izi uchun WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=EduTutor

# ---------- Email (tasdiqlash kodi, parol tiklash) ----------
# console | brevo | resend | smtp   (console — kod server logiga chiqadi, faqat dev)
# brevo: brevo.com da bepul (300 xat/kun), domen shart emas — EMAIL_FROM Brevo'da tasdiqlangan email bo'lsin
EMAIL_PROVIDER=console
EMAIL_FROM="EduTutor <no-reply@edututor.uz>"
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Fayllar ----------
# local | supabase
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=edututor
MAX_UPLOAD_MB=10

# ---------- To'lovlar ----------
# sandbox rejimida haqiqiy pul yechilmaydi
PAYMENT_SANDBOX=true
PLATFORM_COMMISSION_PERCENT=15
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ---------- Video darslar ----------
# webrtc | jitsi
VIDEO_PROVIDER=webrtc
JITSI_BASE_URL=https://meet.jit.si
# TURN server (NAT ortidagi foydalanuvchilar uchun tavsiya etiladi, masalan metered.ca yoki coturn)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- Ijtimoiy kirish (ixtiyoriy) ----------
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---------- Frontend (Vite) ----------
VITE_GOOGLE_CLIENT_ID=
VITE_TELEGRAM_BOT_USERNAME=
